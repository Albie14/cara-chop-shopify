<section class="banner-2">
    <div class="banner-box-1">
        <div class="container-1">
            <span class="txt-box-1" >
                <h4>Crazy Deals</h4>
                <h3>buy 1 get free</h3>
                <h5>The best classic dress is on sale at Cara</h5>
            </span>
            <button type="button">Learn More</button>
        </div>
        <div class="container-2">
            <span class="txt-box-1" >
                <h4>spring/summer</h4>
                <h3>upcoming season</h3>
                <h5>The best classic dress is on sale at Cara</h5>
            </span>
            <button type="button">collection</button>
        </div>
    </div>
    <div class="banner-box-2">
        <div class="container-1">
            <h3>SEASON SALE</h3>
            <h4>Winter Collection -50 % OFF</h4>
        </div>   
        <div class="container-2">
            <h3>NEW FOOTWEAR COLLECTION</h3>
            <h4>spring / Summer 2026</h4>
        </div> 
        <div class="container-3">
            <h3>T-SHIRTS</h3>
            <h4>New Trendy Prints</h4>
        </div> 

    </div>
</section>
{% style %}
    .banner-2{
        margin-top: 24px;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        flex-wrap: wrap;
        width: 100%;
        height: 80vh;
        padding: 0 4%;
    }
    .banner-box-1{
        display: flex;
        justify-content: space-between;
        align-items: stretch;
        height: 60%;
    }
    .banner-box-1 h4{
        color: #fff;
        font-size: 20px;
        font-weight: 300;
    }
    .banner-box-1 h3{
        color: #fff;
        font-size: 28px;
        font-weight: 800;
    }
    .banner-box-1 h5{
        color: #fff;
        font-size: 14px;
        font-weight: 350;
        padding-bottom: 15px;
        margin-bottom: 20px;
    }
    .banner-box-1 .container-1, 
    .banner-box-1 .container-2{
        width: 45%;
        box-sizing: border-box;
        padding: 50px 30px;
    }
    .banner-box-1 .container-1 {
        background-image: url('{{ "banner/b17.jpg" | asset_url }}');
        background-size: cover;
        background-position: center;
    }
    .banner-box-1 .container-2 {
        background-image: url('{{ "banner/b10.jpg" | asset_url }}');
        background-size: cover;
        background-position: center;
    }
    .banner-2 button{
        font-size: 14px;
        font-weight: 600;
        padding: 15px 30px;
        color: #fff;
        background-color: transparent;
        border-radius: 4px;
        cursor: pointer;
        transition: 0.2s;
        border: 1px solid #fff; 
        transition: all ease 0.2s   ;
    }
    .banner-box-1 button:hover{
        background-color: #088178;
        border:1px solid #088178;
        box-shadow: 0px 0px 2px rgba(0, 0, 0, 0.5);
    }

    .banner-box-2{
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        height: 30%;
    }
    .banner-box-2 h3{
        color: #fff;
        font-weight: 900;
        font-size: 22px;
        margin-bottom: 10px;
    }
    .banner-box-2 h4{
        color: #ec544e;
        font-weight: 800;
        font-size: 15px;

    }
    .banner-box-2 .container-1,
    .banner-box-2 .container-2,
    .banner-box-2 .container-3{
        width: 30%;
        background-color: rebeccapurple;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        box-sizing: border-box;
        padding-left: 20px;
        padding-bottom: 20px;
    }
    .banner-box-2 .container-1 {
        background-image: url('{{ "banner/b7.jpg" | asset_url }}');
        background-size: cover;
        background-position: center;
    }
    .banner-box-2 .container-2 {
        background-image: url('{{ "banner/b4.jpg" | asset_url }}');
        background-size: cover;
        background-position: center;
    }
    .banner-box-2 .container-3 {
        background-image: url('{{ "banner/b18.jpg" | asset_url }}');
        background-size: cover;
        background-position: center;
    }

{% endstyle %}