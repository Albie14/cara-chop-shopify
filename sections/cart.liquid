{% comment %}
  This section is used in the cart template to render /cart page with an
  overview of the items in customer's cart.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/cart
{% endcomment %}

<div class="cart-page">
  <h1>Your Cart</h1>

  {% if cart.item_count == 0 %}
    <div class="cart-empty">
      <h2>is empty</h2>
    </div>
  {% else %}
  <form action="{{ routes.cart_url }}" method="post">
    <table class="cart">
      {% for item in cart.items %}
        <tr class="info-product">
          <td class="img-prod">
            {% render 'image', image: item.image, url: item.url %}
          </td>
          <td class="txt-prod">
            <p>{{ item.product.title }}</p>
            <h4 class="price-prod" data-price={{ item.product.price }}>{{ item.product.price | money }}</h4>
          </td>

          <td class="group-quantity-prod">
                <button type="button" class="btn-add-cart minus-quantity">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 btn-qty  ">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                </svg>
              </button>
              
            <input type="text" name="updates[]" value="{{ item.quantity }}" class="input-qty-product"> 
            
                <button type="button" class="btn-add-cart plus-quantity">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 btn-qty ">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 15.75 7.5-7.5 7.5 7.5" />
                </svg>
              </button>
          </td>

          <td class="total-prod">
            <h2 data-line-total="{{ item.final_line_price }}">{{ item.final_line_price | money }}</h2>
          </td>

          <td class="remove-prod">
            <a href="{{ item.url_to_remove   }}">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 icon-delete">
                <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
              </svg>
            </a>
          </td>
        </tr>
      {% endfor %}
    </table>
    <tr class="info-total">
      <td data-cart-total="{{ cart.total_price }}"><h2>Total: {{ cart.total_price | money }}</h2></td>
    </tr>
    <input type="submit" name="checkout" value="{{ 'cart.checkout' | t }}" class="btn-cart-chekout">
    
  </form>    
  {% endif %}
  
</div>



{% stylesheet %}
  .cart-page{
    margin-top: 10%;
    height: auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
  }
  
  .cart-page form{
    width: 90%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
  }
  .cart{
    width: 100%;
  }
  .info-product{
    outline: 1px  solid #088178;
    border-radius: 8px;
    width: 100%;
    height: 90px;
    box-sizing: border-box;
    padding: 4px 8px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
  }
  .img-prod{
    width: 10%;
    height: 100%;
    overflow: hidden;
    aspect-ratio: 1/1;
    border-radius: 8px;

  }
  .img-prod img{
    height: 100%;
    width: 100%;
  }
  .txt-prod{
    width: 30%;
  }
  .group-quantity-prod{
    width: 13%;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .group-quantity-prod input{
    height: 32px;
    text-align: center;
    padding-left: 0;
  }
  .total-prod{
    width: 10%;
  } 
  .remove-prod{
    width: 10%;

  } 
  .icon-delete{
    height: 24px;
    color: #222222;
  }

  .icon-delete:hover{
    color: #088178;
  }

  .cart-empty{
    height: 80%;
  }
.info-total{
  width: 100%;
  text-align: center;
}
  .btn-cart-chekout{
    font-size: 14px;
    font-weight: 600;
    padding: 15px 30px;
    color: #000;
    background-color: #fff;
    border-radius: 4px;
    cursor: pointer;
    border: 1px solid #088178;
    transition: 0.2s;
    
  }

  .btn-cart-chekout:hover{
      background-color: #088178;
      color: #fff;
  }
  .cart .btn-cart-chekout{
    text-align: left;
  }
{% endstylesheet %}
{% schema %}
{
  "name": "t:general.cart",
  "settings": []
}
{% endschema %}
