<div class="contact">
    <h2>Contact us</h2>
    <div class="content">
        <div class="contac-1">
            <div class="box-1">
                {% render 'form-contact' %}
            </div>
            <div class="box-2">
                {% render 'schedules' %}
            </div>
        </div>
        <div class="contac-2">
            <div class="box-3">
                {% render 'address' %}
            </div>
            <div class="box-4">
                {% render 'social-media' %}
            </div>
        </div>
    </div> 

</div>


{% stylesheet %}
    .contact{
        margin-top: 25vh;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
    }
    .content{
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        width: 90%;
        height: 60vh;
        margin-top: 32px;
    }
    .contac-1{
        height: 100%;
        width: 48%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: stretch;
    
    }
    .box-1{
        height: 50%;
        outline: 2px solid #088178;
        background-color: #e3e6f3;
        border-radius: 8px;

    }
    .box-2{
        height: 45%;
        outline: 2px solid #088178;
        border-radius: 8px;
    }
    .contac-2{
        height: 100%;
        width: 48%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: stretch;
    }
    .box-3{
        height: 70%;
        outline: 2px solid #088178;
        border-radius: 8px;
    }
    .box-4{
        height: 25%;
        outline: 2px solid #088178;
        border-radius: 8px;
    }
{% endstylesheet %}