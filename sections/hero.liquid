<section>
    <aside>
        <h6>Trade-in-Offer</h6>
        <h3>Super value deals</h3>
        <h2>On all products</h2>
        <p>Save more width cuopons & up to 70% off!</p>
        <button type="button">Shop Now</button>
    </aside>

</section>

{% style %}

    section{
        background-image: url('{{ "hero4.png" | asset_url }}');
        height: 90vh;
        width: 100%;
        background-size: cover;
        background-position: top 25% right 0;
        box
        padding: 0 80px;
        margin-top: clamp(2rem, 20vh, 10rem);
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: center;
        box-sizing: border-box;
    }    
    aside{
        width: 40%;
        height: 60%;
        margin-left: 5%;
        display:flex;
        flex-direction: column;
    }
    h6{
        font-size:1.5rem;
        font-weight: 500;
        -webkit-text-stroke: 0.8px currentColor;
        margin-bottom: 1rem;
    }
    h3{
        font-size:3rem;
        font-weight: 550;
    }
    h2{
        color:#088178;
        font-size:3rem;
        transform: scaleY(1.2);
        letter-spacing: 1px ;
        font-weight: 500;
        -webkit-text-stroke: 3px currentColor;
        margin-bottom: 2rem;
    }
    p{
        font-size: 16px;
        color: #465b52;
    }

    aside button{
    background-image: url('{{ "button.png" | asset_url }}');
    background-color: transparent;
    color: #088178;
    border: 0;
    padding: 0;
    box-sizing: border-box;
    height: 3rem;
    background-repeat: no-repeat;
    cursor: pointer;
    font-weight: 700;
    font-size: 15px;
    width: 40%;
    }

{% endstyle %}
