<div class="collection-featured-products">
    <div class="name-collection">
        <h2 class="title-collection" > {{ collections['featured-products'].title }}</h2>
        {{ collections['featured-products'].description }}
    </div>
   
    <div class="products-container">
        {% for product in collections['featured-products'].products %}

            <div class="product-card" data-collection="{{ product.tags | join: ' ' | downcase }}">
        
                <a href="{{ product.url }}">
                    <img src="{{ product.featured_image | image_url}}" width="50" height="50" alt="{{ product.title }}" loading="lazy">
                </a>
    
                <div class="text-card">
                    <h3>{{ product.title }}</h3>
                    <p>{{ product.description | strip_html | truncate: 120 }}</p>
                    {% render 'icon-star-group' %}
                </div>
                <div class="pay-card">
                    <p class="price">{{ product.price | money }}</p>
                    <button type="button" class="btn-add-cart"> <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6  icon-add-cart">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm7.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
                        </svg>
                    </button>
                </div>
            </div>
        {% endfor %}
    </div>

</div>

{% stylesheet %}
    .collection-featured-products{
        width: 100%;
        margin-top: 2%;
        text-align: center;
    }
    .name-collection{
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: stretch;
        width: 100%;
    }
    .name-collection .title-collection{
        font-size: 40px;
        color: #222;
        letter-spacing: 3px;
        margin-bottom: 4px;
    }

    .name-collection span{
        font-size: 16px;
        color: #465b52;
        margin-top: 0;

    }
    .products-container{
        display: flex;
        justify-content: space-around;
        flex-wrap: wrap;
        box-sizing: border-box;

    }
    .product-card{
        width: 20%;
        overflow: hidden;
        border: 1px solid #25b83b;
        border-radius: 24px;
        box-shadow: 20px 20px 30px rgba(0, 0, 0, 0.02);
        margin: 15px;
        transition: 0.2s ease;
        box-sizing: border-box;
        padding: 1%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }
    .product-card:hover{
        box-shadow: 20px 20px 30px rgba(0, 0, 0, 0.06);
    }
    .product-card a{
        height: 200px;
        width: 100%;
        display: block;
        box-sizing: border-box;
        padding: 8% 10%;
        margin-bottom: 20px;
    }
    .product-card a img{
        width: 100%;
        height: 100%;
        border-radius: 16px;
    }
    .text-card{
        height: auto;
        text-align: left;
    }
    .text-card h3{
        font-size: clamp(8px, 16px, 30px);
        margin-bottom: 8px;
        color: #1a1a1a;
        font-weight: 500;
        letter-spacing: 0.5px;
        -webkit-text-stroke: 0.8px black;
    }
    .text-card h3::first-letter{
        text-transform: uppercase;
    }
    .pay-card{
        display: flex;
        justify-content: space-between;
        align-items: center;
        width: 100%;
        box-sizing: border-box;
        padding:  0 8px;
    }
    .pay-card .price{
        font-size: 24px;
        color: #088178;
        font-weight: 500;
        letter-spacing: 0.5px;
        -webkit-text-stroke: 0.8px #088178;
    }
    .btn-add-cart{
        width: 40px;
        height: 40px;
        border-radius: 20px;
        background-color: #e8f6ea;
        border: 1px solid #cce7d0;
        cursor: pointer;
    }
    .icon-add-cart{
        color: #088178;
        transition: all ease 0.5s;
        border-radius: 20px;
        outline: none;
        
    }
    .icon-add-cart:hover{
        outline: 1px solid #b5e2bc;
        outline-offset: 8px;
        border-radius: 20px;
        border: none;
    }

    @media(max-width: 768px){
        .product-card{
            width: 40%;
        }
        .product-card a{
            padding-top: 10%;
        }
    }
{% endstylesheet %}