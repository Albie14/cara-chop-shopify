<div class="collection-featured-products">
    <h2>{{ collections['featured-products'].title }}</h2>
    <p>{{ collections['featured-products'].description }}</p>
    <div class="products-container">
        {% for product in collections['featured-products'].products %}
            <div class="product-card" data-collection="{{ product.tags | join: ' ' | downcase }}">
        
                <a href="{{ product.url }}">
                    <img src="{{ product.featured_image | image_url}}" width="50" height="50" alt="{{ product.title }}">
                </a>
    
                <div class="text-card">
                    <h3>{{ product.title }}</h3>
                    <p>{{ product.description | strip_html | truncate: 120 }}</p>
                    {% render 'icon-star-group' %}
                </div>
                <div class="pay-card">
                    <p>{{ product.price | money }}</p>
                    <button type="button" class="btn-style">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 add-cart">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm7.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" />
                        </svg>                        
                    </button>
                    </div>
            </div>
        {% endfor %}
    </div>

</div>

{% stylesheet %}
    .collection-featured-products{
        height: 100vh;
        width: 100%;
        outline: 1px solid red;
    }
    .products-container{
        display: flex;
        justify-content: space-between;
        padding-top: 20px;
        flex-wrap: wrap;
        outline: 1px solid blue;

    }
    .product-card{
        width: 20%;
        max-width: 250px;
        height: clamp(300px, 100px, 2000px);
        padding: 10px 12px;
        border: 1px solid #25b83b;
        border-radius: 25px;
        box-shadow: 20px 20px 30px rgba(0, 0, 0, 0.02);
        margin: 15px;
        transition: 0.2s ease;
    }
    .product-card a{
        height: 60%;
        width: 90%;
        outline: 2px solid greenyellow;
        overflow: hidden;
        border-radius: 20px;
        
    }
    .product-card a img{
    width: 100%;
    /* display: none; */

    }
    .text-card{
        outline: 2px solid purple;
    }
    .text-card h3{
        font-size: 10px;
    }

{% endstylesheet %}