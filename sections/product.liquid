{% comment %}
  This section is used in the product template to render product page with
  media, content, and add-to-cart form.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}

<div class="product-page">
  <div class="product-images">
    {% for image in product.images %}
      {% render 'image', class: 'product-image', image: image %}
    {% endfor %}
  </div>

  <div class="product-info">
    <div class="product-txt">
      <h2>{{ product.title }}</h2>
      <p>{{ product.price | money }}</p>
    </div>

    <div class="product-form">
      {% form 'product', product %}
        <div class="quantity-product-in-cart">
          <div class="quantity-product">
            <button type="button" class="btn-add-cart">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 btn-qty  minus-quantity">
                <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
              </svg>
            </button>
            <input type="number" name="quantity" min="1" value="1" readonly class="input-qty-product">
            <button type="button" class="btn-add-cart">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 btn-qty plus-quantity">
                <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 15.75 7.5-7.5 7.5 7.5" />
              </svg>
            </button>
          </div>
        <input type="submit" value="Add to cart" class="btn-product-add-cart">

        </div>
      {% endform %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:general.product",
  "settings": [],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
