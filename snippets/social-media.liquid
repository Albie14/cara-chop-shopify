            </a>
        {% endif %}
    </div>
</div>

{% stylesheet %}
    .social-media h3{
        margin-bottom: 16px;
    }
    .icons-social-media{
        display: flex;
        justify-content: center;
        padding: 0 48px;
        gap: 8px;
    }
    .social-item{
        color: #222222;
        height: 48px;
        width: 128px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 1;
        transition: flex 0.8s ease;
        cursor: pointer;
        outline: 1px solid red;

    }
    .social-item svg{
        height: 100%;
        width: 32px;

    }
    .social-item span{
        opacity: 0;
        display: none;
        white-space: nowrap;
        color: #088178;
        transition: opacity 0.8s ease;
        /* transform: scaleY(1.4); */
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 0.8px;
        -webkit-text-stroke: 0.3px #088178;
    }
    .social-item:hover{
        color: #088178;
        flex: 2;
        justify-content: space-evenly;
        /* transition: all 0.3s ease; */

    }
    .social-item:hover span{
        opacity: 1;
        display: flex;
    }

{% endstylesheet %}